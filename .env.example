# Client-facing gateway key. AI clients only need this key to call memory-gateway.
GATEWAY_API_KEY=change-me

# Fallback chat model configuration.
# Used when no SQLite/TOML provider route is available.
UPSTREAM_BASE_URL=https://open.bigmodel.cn/api/paas/v4
UPSTREAM_API_KEY=your-upstream-api-key
UPSTREAM_MODEL=glm-5.1

# Optional multi-provider routing config.
# If this file does not exist or contains no usable route, the service falls back to UPSTREAM_*.
PROVIDERS_CONFIG_PATH=config/providers.toml

# Optional embedding configuration.
# Leave EMBEDDING_API_KEY empty to use keyword-search fallback.
EMBEDDING_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
EMBEDDING_API_KEY=your-embedding-api-key
EMBEDDING_MODEL=text-embedding-v4
EMBEDDING_DIMENSIONS=1024

# Local SQLite database path.
DATABASE_PATH=data/memory.db

# Upstream request timeout in seconds.
REQUEST_TIMEOUT_SECONDS=60
