<?xml version="1.0" encoding="utf-8"?>
<!-- Android blocks cleartext HTTP by default, loopback included. This only
     governs this app's own health polling; the system browser and third-party
     chat apps carry their own policies (Chrome allows http://127.0.0.1). -->
<network-security-config>
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">127.0.0.1</domain>
        <domain includeSubdomains="false">localhost</domain>
    </domain-config>
</network-security-config>
