{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://memory-gateway.local/schemas/routes.schema.json",
  "title": "memory-gateway feature routes",
  "type": "object",
  "required": ["version", "routes"],
  "additionalProperties": false,
  "properties": {
    "$schema": {"type": "string"},
    "version": {"const": 1},
    "routes": {
      "type": "object",
      "propertyNames": {"enum": ["chat", "memory.extract", "memory.compact", "memory.core", "memory.review", "knowledge.fast", "knowledge.pro", "pricing.research"]},
      "additionalProperties": {
        "type": "array",
        "minItems": 1,
        "uniqueItems": true,
        "items": {"type": "string", "minLength": 1}
      }
    }
  }
}
