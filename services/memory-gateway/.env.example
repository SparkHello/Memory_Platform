# Client-facing gateway key. AI clients only need this key to call memory-gateway.
GATEWAY_API_KEY=change-me
# Bind this credential to one memory namespace. Callers cannot select another
# X-User-Id unless the temporary legacy migration switch below is enabled.
GATEWAY_USER_ID=default
GATEWAY_ALLOW_USER_ID_HEADER=false

# Transparent OpenAI Chat Completions memory proxy. It is enabled by default.
# read-write = recall/inject safe memories and extract new long-term memories
# after a complete final answer; read = recall only; off = transparent proxy.
CHAT_GATEWAY_ENABLED=true
CHAT_GATEWAY_DEFAULT_MEMORY_MODE=read-write
CHAT_GATEWAY_SEARCH_LIMIT=8
# "What do you know about me" style questions match no specific memory by
# similarity. When recall is empty and the message is clearly about the user,
# inject the most important normal memories (up to CHAT_GATEWAY_SEARCH_LIMIT).
CHAT_GATEWAY_SELF_REFERENCE_RECALL=true
CHAT_GATEWAY_CONTEXT_MAX_CHARS=12000
# Maximum time spent on semantic recall before local keyword fallback.
CHAT_GATEWAY_RECALL_TIMEOUT_SECONDS=4
# Keep slow first-token/reasoning streams alive as long as FLIT's normal timeout.
CHAT_GATEWAY_STREAM_READ_TIMEOUT_SECONDS=600
# Allow large image/audio request bodies the same upload window as FLIT.
CHAT_GATEWAY_STREAM_WRITE_TIMEOUT_SECONDS=120
# Reject oversized multimodal JSON before FastAPI materializes it in memory.
CHAT_GATEWAY_MAX_REQUEST_BODY_BYTES=33554432
# Short process-local window for side-effect idempotency and FLIT tool reasoning replay.
CHAT_GATEWAY_TURN_TTL_SECONDS=3600
# Memory extraction receives the rolling compressed summary plus this many
# recent completed user/assistant turns for pronoun and short-answer resolution.
# 4 keeps a several-turn Q&A (guessing games, follow-up confirmations) inside
# the window before compression starts at 8 turns.
CHAT_GATEWAY_EXTRACTION_CONTEXT_TURNS=4
CHAT_GATEWAY_EXTRACTION_CONTEXT_MAX_CHARS=8000
# Older normal-sensitivity turns are compressed in the background after either
# threshold is reached. The newest extraction-context turns stay verbatim.
CHAT_GATEWAY_CONTEXT_COMPACT_AFTER_TURNS=8
CHAT_GATEWAY_CONTEXT_COMPACT_AFTER_CHARS=6000
CHAT_GATEWAY_COMPACTED_SUMMARY_MAX_CHARS=4000
# Skip the memory.extract call for turns that are only greetings/acknowledgements,
# only questions, or only code. Explicit 记住/remember requests and short answers
# to an assistant question are never skipped; skips are written to decision logs.
CHAT_GATEWAY_EXTRACTION_PREFILTER=true

# Required model plane: the independent Model_Gateway service owns all
# provider accounts, deployments, model routing, adapters, health and pricing.
# Set the URL and client key together; this pair is the only model path.
MODEL_GATEWAY_BASE_URL=
MODEL_GATEWAY_ALLOW_PRIVATE_HTTP=false
MODEL_GATEWAY_API_KEY=
MODEL_GATEWAY_CHAT_MODEL=memory.chat
MODEL_GATEWAY_MEMORY_EXTRACT_MODEL=memory.extract
MODEL_GATEWAY_MEMORY_COMPACT_MODEL=memory.compact
MODEL_GATEWAY_MEMORY_CORE_MODEL=memory.core
MODEL_GATEWAY_MEMORY_REVIEW_MODEL=memory.review
MODEL_GATEWAY_KNOWLEDGE_FAST_MODEL=knowledge.fast
MODEL_GATEWAY_KNOWLEDGE_PRO_MODEL=knowledge.pro
MODEL_GATEWAY_EMBEDDING_MODEL=memory.embedding
# Copy the exact immutable embedding_space declared by the selected gateway
# deployment. If blank, semantic vectors are disabled and retrieval safely
# falls back to local keyword/FTS rather than mixing unknown vector spaces.
MODEL_GATEWAY_EMBEDDING_SPACE_ID=

# Sensitive text (passwords, IDs, account numbers) is never sent to remote
# extraction/embedding/review/knowledge-agent providers by default.
# Enable only when the configured providers are approved to process sensitive data.
ALLOW_SENSITIVE_EGRESS=false
# Highest local sensitivity tier that memory extraction and embedding may still
# send out while ALLOW_SENSITIVE_EGRESS is false. "private" (default) lets
# health/address/contact/income sentences reach the extraction model like the
# rest of the chat did; "normal" withholds them sentence by sentence as well.
MEMORY_EGRESS_CEILING=private

# When a new memory carries an explicit transition marker (换成/改成/现在/不再,
# switched/now) and matches an older fact about the same attribute, close the
# old one in place (kept as history, restorable) instead of leaving a duplicate
# for the review page. Needs embeddings; set to false to keep review-only mode.
MEMORY_AUTO_SUPERSEDE=true

# Declared embedding vector dimensions for the central memory.embedding route.
# Must match the gateway space/dimension headers and the actual vector length;
# on mismatch vectors are disabled and retrieval falls back to keyword/FTS.
EMBEDDING_DIMENSIONS=1024

# Local SQLite database path.
DATABASE_PATH=data/memory.db
AUTH_DATABASE_PATH=data/auth.db

# Physically separate long-text knowledge database. It must not resolve to DATABASE_PATH.
KNOWLEDGE_DATABASE_PATH=data/knowledge.db
# Readiness warns below the soft reserve; write APIs preserve the hard reserve.
# Volumes smaller than 1 GiB adapt these defaults to 1/16 and 1/64 of capacity.
DISK_SOFT_RESERVE_BYTES=67108864
DISK_HARD_RESERVE_BYTES=16777216
KNOWLEDGE_MAX_DOCUMENT_BYTES=52428800
# Knowledge chunks reuse the central memory.embedding route above.
# Without a configured embedding space, knowledge retrieval stays on local FTS.
KNOWLEDGE_EMBEDDING_BATCH_SIZE=20
KNOWLEDGE_EMBEDDING_MIN_COSINE=0.25
KNOWLEDGE_HYBRID_VECTOR_WEIGHT=0.65

# Knowledge-agent-only egress and timeout controls.
KNOWLEDGE_AGENT_EGRESS_POLICY=none
KNOWLEDGE_AGENT_TIMEOUT_SECONDS=25

# Local evaluation workbench directory. Contains real-memory snapshots and labels; keep gitignored.
EVAL_DIR=eval

# Web console static files directory. Empty = <repo>/ui/dist next to the backend.
# A configured directory must be a dedicated Vite build with index.html and assets/.
# The server exposes only the UI entrypoint, known root assets, and assets/*.
UI_DIST_DIR=

# Upstream request timeout in seconds.
REQUEST_TIMEOUT_SECONDS=60

# Memory decay. Lambdas/alpha must be non-negative; weights and lifecycle
# factors must stay in [0, 1]. Sector lambdas must be finite values in [0, 10].
DECAY_LAMBDA_DEFAULT=0.02
DECAY_ALPHA_DEFAULT=0.3
DECAY_SHORT_TERM_DAYS=3
DECAY_SHORT_TERM_TIME_WEIGHT=0.7
DECAY_LONG_TERM_EMOTION_WEIGHT=0.7
DECAY_RESOLVED_FACTOR=0.05
DECAY_DIGESTED_FACTOR=0.02
DECAY_SECTOR_LAMBDA_MAP={"emotional":0.01,"reflective":0.01,"semantic":0.02,"procedural":0.02,"episodic":0.03}
