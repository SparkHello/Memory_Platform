{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://memory-gateway.local/schemas/models.schema.json",
  "title": "memory-gateway model catalog",
  "type": "object",
  "required": ["version", "models"],
  "additionalProperties": false,
  "properties": {
    "$schema": {"type": "string"},
    "version": {"const": 1},
    "models": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "provider", "model", "kind"],
        "additionalProperties": false,
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]*/\\S+$"},
          "provider": {"enum": ["mimo", "kimi", "deepseek", "upstream", "embedding"]},
          "model": {"type": "string", "minLength": 1},
          "kind": {"enum": ["chat", "embedding"]},
          "capabilities": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
          "official_url": {"type": "string"}
        }
      }
    }
  }
}
