{
  "version": 1,
  "note": "内置供应商预置。quirks 取值来源：(a) 2026-08-03 之前散落在 llm/client.py 与 openai_compat/gateway_client.py 的 9 处 base_url 子串嗅探；(b) 2026-08-03 对各模型的实测。用户只需提供 api_key，其余字段可在 providers.json 中逐项覆盖。 legacy_api_key_envs 是迁移期兼容：MKD 时代的变量名仍被识别，迁移完成后可整体删除。",
  "presets": {
    "kimi": {
      "name": "Kimi（月之暗面）",
      "protocol": "openai",
      "api_host": "https://api.moonshot.cn/v1",
      "quirks": {
        "thinking_style": "type_object",
        "structured_output": "json_schema",
        "tool_choice_with_thinking": "auto_only",
        "requires_reasoning_replay": true
      },
      "models": [
        {
          "id": "kimi-k2.7-code",
          "kind": "chat",
          "quirks": {
            "thinking_style": "type_object_keep_all",
            "forces_temperature_one": true
          }
        },
        {
          "id": "kimi-k2.7-code-highspeed",
          "kind": "chat",
          "quirks": {
            "thinking_style": "type_object_keep_all",
            "forces_temperature_one": true
          }
        }
      ],
      "urls": {
        "website": "https://platform.moonshot.cn",
        "api_key": "https://platform.moonshot.cn/console/api-keys",
        "docs": "https://platform.kimi.com/docs/pricing/chat-k27-code"
      },
      "legacy_api_key_envs": [
        "LLM_KIMI_API_KEY"
      ]
    },
    "deepseek": {
      "name": "DeepSeek",
