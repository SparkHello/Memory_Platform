.DS_Store
.env
**/.env
.venv/
**/.venv/
__pycache__/
**/__pycache__/
*.py[cod]
.pytest_cache/
**/.pytest_cache/
.ruff_cache/
**/.ruff_cache/
*.egg-info/
**/*.egg-info/
.claude/
**/.claude/
.codex/
**/.codex/
.pwshot/
**/.pwshot/
.playwright-mcp/
**/.playwright-mcp/
.kun-design/
**/.kun-design/
data/*.db
**/data/*.db
**/data/*.db-*
logs/
**/logs/
eval/
**/eval/
ui/node_modules/
**/ui/node_modules/
ui/dist/
**/ui/dist/
services/memory-gateway/ui/test-results/
memory-stack*.zip
/key.md
# Runtime credentials and secret-bearing settings are never source artifacts.
credentials/
**/credentials/
settings.env
**/settings.env
secrets.env
**/secrets.env
# Ad-hoc console screenshots captured at the repo root. Scoped to the root so
# real image assets under ui/ or docs/ stay committable.
/*.png
# Generic dependency dirs: a stray root-level npm/vitest run once left a
# root node_modules behind, so do not limit the rule to ui/.
node_modules/
**/node_modules/
# Local AI/tool state dirs, same convention as .claude/ and .codex/ above.
.impeccable/
**/.impeccable/
.kun-canvas/
**/.kun-canvas/
.reasonix/
**/.reasonix/
